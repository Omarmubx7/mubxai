# .env.example - Copy this to .env.local and fill in your actual values
# DO NOT COMMIT THIS FILE with real credentials - this is documentation only

# ============================================================
# LOCAL DEVELOPMENT DATABASE CONFIGURATION
# ============================================================
# For local development, you have 2 options:

# OPTION 1: Local PostgreSQL (recommended)
# - Install PostgreSQL locally
# - Create a database: createdb htuai_dev
# - Update the password below with your local postgres password
POSTGRES_PRISMA_URL="postgresql://postgres:YOUR_LOCAL_PASSWORD@localhost:5432/htuai_dev?schema=public&sslmode=disable"
POSTGRES_URL="postgresql://postgres:YOUR_LOCAL_PASSWORD@localhost:5432/htuai_dev?sslmode=disable"
POSTGRES_URL_NON_POOLING="postgresql://postgres:YOUR_LOCAL_PASSWORD@localhost:5432/htuai_dev?sslmode=disable"

# OPTION 2: Neon PostgreSQL (separate dev database, not production)
# - Create a NEW Neon database just for development
# - Never use production Neon credentials in .env.local
# POSTGRES_PRISMA_URL="postgresql://user:password@your-dev-neon-db.us-east-1.aws.neon.tech/dev_db?connect_timeout=15&sslmode=require"

# ============================================================
# SESSION / AUTH CONFIGURATION
# ============================================================
# Only used for non-browser callbacks and as a fallback. OAuth redirect URIs
# are derived from the incoming request origin, so localhost and production
# both work without changing this value.
NEXTAUTH_URL=http://localhost:3000
# Generate a random secret: openssl rand -hex 32
NEXTAUTH_SECRET=your_random_secret_here

# ============================================================
# OAUTH PROVIDERS (Local Testing)
# ============================================================
#
# In Google Cloud Console → APIs & Services → Credentials → your OAuth 2.0
# Web client, add BOTH authorised redirect URIs:
#
#   http://localhost:3000/api/auth/google/callback
#   https://<your-domain>/api/auth/google/callback
#
# The Client ID must belong to the same client as the secret below.
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_client_id

# ============================================================
# API KEYS & SECRETS
# ============================================================
# For local development only - use different values in production!
ADMIN_SECRET=local_dev_secret_change_in_production
GROQ_API_TOKEN=your_groq_api_token

# ============================================================
# PRODUCTION ENVIRONMENT VARIABLES (Cloudflare Workers Only)
# ============================================================
# DO NOT add these to .env.local
# Set these in Cloudflare Dashboard → Workers → mubxai → Settings → Variables
# AND in Build & Deploy → Build environment variables:
#
# DATABASE_URL = your production Neon pooled connection string
# NEXTAUTH_URL = https://yourdomain.com
# NEXTAUTH_SECRET = different random secret than local
# GOOGLE_CLIENT_ID = production OAuth credentials
# GOOGLE_CLIENT_SECRET = production OAuth credentials
# ADMIN_SECRET = production admin secret
# GROQ_API_TOKEN = your API token (or use different one in prod)
